{
    "name": "tonto-redesign",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "langium:generate": "npm run langium:generate --workspace=tonto-language",
        "versions:check": "node scripts/versioning.mjs check",
        "release:prepare": "node scripts/versioning.mjs prepare",
        "release": "node scripts/release.mjs",
        "build": "npm run langium:generate && npm run build --workspace=tonto-language && npm run build --workspace=tonto-mcp && npm run build --workspace=tonto-vscode",
        "package": "npm run build && npm run package --workspace=tonto-vscode",
        "dev:install": "node scripts/dev-install.mjs",
        "dev:link-cli": "node scripts/link-cli.mjs",
        "dev:unlink-cli": "node scripts/unlink-cli.mjs",
        "install:local": "npm run dev:install",
        "watch": "npm run watch --workspaces --if-present",
        "test": "npm run test --workspace=tonto-language",
        "test:vscode": "npm run build && npm run test:integration --workspace=tonto-vscode",
        "test:gufo-conformance": "npm run build && node packages/language/test/gufo-conformance.mjs",
        "lint": "npm run lint --workspaces --if-present"
    },
    "devDependencies": {
        "typescript": "^5.6.0"
    },
    "engines": {
        "node": ">=22"
    }
}
